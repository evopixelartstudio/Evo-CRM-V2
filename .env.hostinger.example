# =============================================================================
# DeskcommCRM — template de ambiente para Hostinger VPS (Ubuntu 24.04 + Docker).
# Copie para `.env` e preencha conforme as instruções abaixo.
#
# Regra de ouro:
#  - NEXT_PUBLIC_*  = embutidas no BUILD (lidas em runtime pelo browser).
#  - as demais      = injetadas em RUNTIME pelo docker-compose (trocar = restart).
# =============================================================================

# -----------------------------------------------------------------------------
# 0) IMAGENS DOCKER OFICIAIS (pré-compiladas — não compilam na VPS)
# -----------------------------------------------------------------------------
# Imagens multi-arquitetura (amd64 / arm64) oficiais.
# Em produção, utilize tags fixas ou ':stable' (última versão estável testada).
APP_IMAGE=ghcr.io/melgarafael/deskcommcrm:stable
APP_PULL_POLICY=always

WORKER_IMAGE=ghcr.io/melgarafael/deskcomm-worker:stable
WORKER_PULL_POLICY=always
SCHEDULER_IMAGE=ghcr.io/melgarafael/deskcomm-scheduler:stable
SCHEDULER_PULL_POLICY=always

# ── Chamada de voz WhatsApp (Opcional — DESLIGADA por padrão) ────────────────
COMPOSE_PROFILES=
WACALLS_API_BASE_URL=
WACALLS_ADMIN_USER=
WACALLS_ADMIN_PASSWORD=
WACALLS_API_TOKEN=

# -----------------------------------------------------------------------------
# 1) DOMÍNIO E PROXY REVERSO (HTTPS)
# -----------------------------------------------------------------------------
# Aponte o registro A do seu domínio/subdomínio para o IP da sua VPS Hostinger:
DOMAIN=crm.seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br

# Quem responde nas portas 80/443:
#   caddy   → O compose sobe o Caddy interno para emitir e renovar SSL automaticamente (VPS crua / padrão).
#   traefik → Se sua VPS Hostinger já tiver Traefik instalado pelo painel (hPanel/templates).
#             Nesse caso, utilize o compose com:
#             docker compose -f docker-compose.prod.yml -f docker-compose.traefik.yml up -d
#
# Deixe comentado se for utilizar o instalador interativo (ele detecta sozinho):
#REVERSE_PROXY=caddy

# Configurações se REVERSE_PROXY=traefik:
#TRAEFIK_NETWORK=traefik
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_ENTRYPOINT_HTTP=web
#TRAEFIK_CERTRESOLVER=letsencrypt

# -----------------------------------------------------------------------------
# 2) SUPABASE (Integração preservada — Cloud ou Self-Hosted)
# -----------------------------------------------------------------------------
# No painel do Supabase (supabase.com) → Project Settings → API e Database:
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Connection String do banco:
# ATENÇÃO: Na VPS IPv4 da Hostinger, utilize a connection string do "Session Pooler"
# (porta 5432 ou 6543 em modo URI), NUNCA a "Direct connection" (que é IPv6-only).
SUPABASE_DB_URL=postgresql://postgres.SEU-PROJETO:[SUA-SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Se utilizar Supabase Self-Hosted na própria VPS (opcional):
#SUPABASE_DB_ADMIN_URL=

# -----------------------------------------------------------------------------
# 3) URLs DA APLICAÇÃO (Devem coincidir com o DOMAIN acima)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://crm.seudominio.com.br
NEXT_PUBLIC_ADMIN_URL=https://crm.seudominio.com.br

# -----------------------------------------------------------------------------
# 4) INTELIGÊNCIA ARTIFICIAL (Paga por uso — Anthropic, OpenAI ou OpenRouter)
# -----------------------------------------------------------------------------
# Chave da Anthropic (Claude) — padrão recomendado:
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=

# Ou OpenRouter (opcional):
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=

# Opcional — para transcrição de áudios no WhatsApp:
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# 5) SEGREDOS CRIPTOGRÁFICOS INTERNOS (Gere com: openssl rand -hex 32)
# -----------------------------------------------------------------------------
INTERNAL_SECRET=
INTERNAL_CRON_SECRET=
TENANT_PROVISIONING_SECRET=
CPF_ENCRYPTION_KEY=
AI_CRED_AES_KEY=
WAHA_BYO_ENCRYPTION_KEY=
IMPERSONATE_COOKIE_SECRET=
LGPD_SIGNING_KEY=

# -----------------------------------------------------------------------------
# 6) WHATSAPP / WAHA (Core gratuito integrado)
# -----------------------------------------------------------------------------
WAHA_API_BASE_URL=http://waha:3000
WAHA_WEBHOOK_BASE_URL=http://app:3000
WHATSAPP_RESTART_ALL_SESSIONS=True
WAHA_API_KEY=
WAHA_API_KEY_SHA512=
WAHA_HMAC_SECRET=

# -----------------------------------------------------------------------------
# 7) REDIS E CACHE (Executado localmente via Docker)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=http://srh:80
UPSTASH_REDIS_REST_TOKEN=
SRH_TOKEN=

# -----------------------------------------------------------------------------
# 8) CONFIGURAÇÕES GERAIS DE PRODUÇÃO
# -----------------------------------------------------------------------------
NODE_ENV=production
NUVEMSHOP_ENABLED=false
INTERNAL_AGENT_RUN_STUB=false

# -----------------------------------------------------------------------------
# 9) E-MAIL TRANSACIONAL (Resend ou SMTP próprio da Hostinger)
# -----------------------------------------------------------------------------
# Opção A: Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Opção B: SMTP (ex: Titan Mail / Hostinger Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# -----------------------------------------------------------------------------
# 10) ADMINISTRADOR INICIAL (Bootstrap)
# -----------------------------------------------------------------------------
OWNER_EMAIL=admin@seudominio.com.br
OWNER_PASSWORD=

# -----------------------------------------------------------------------------
# 11) AGENT ENGINE
# -----------------------------------------------------------------------------
AGENT_DISPATCH_CONSUMER=engine
#AI_BUDGET_ENFORCEMENT=on

# -----------------------------------------------------------------------------
# 12) IDENTIDADE VISUAL / WHITE-LABEL (Opcional)
# -----------------------------------------------------------------------------
APP_NAME=
APP_LOGO_URL=
APP_ACCENT_HEX=
SUPPORT_EMAIL=

